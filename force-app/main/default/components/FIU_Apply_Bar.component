<!--
  Keeps the Apply link on screen: a slim bar that appears once the banner's Apply link scrolls out of view.
  Applying is the main goal of these pages, so it stays reachable through the whole registration flow.

  On phones the bar sits at the bottom and also carries a Register link until the visitor first reaches the form,
  so it replaces FIU_Floating_Register. Don't use both on a template.
  Place after the template's rsvp.js script tag, because it reads the state that script sets.
-->
<apex:component layout="none">
    <apex:attribute name="applyUrl" type="String" required="true" description="Where the Apply link goes." />
    <apex:attribute name="applyLabel" type="String" default="Apply Today"
        description="The link's text. Exec Ed has no application, so its templates pass Explore Programs." />
    <div id="fiu-apply-bar" hidden="hidden">
        <span class="fiu-apply-bar__text">Ready to take the next step?</span>
        <a class="fiu-apply-bar__register" href="#main-content" hidden="hidden">Register</a>
        <a class="fiu-apply-bar__apply" href="{!applyUrl}" rel="noopener" target="_blank">{!applyLabel}</a>
    </div>
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            var bar = document.getElementById("fiu-apply-bar");
            var register = bar.querySelector(".fiu-apply-bar__register");
            var bannerLink = document.querySelector("#banner .contact-info");
            var hero = document.getElementById("registerToday");
            var form = document.getElementsByTagName("form")[0];
            var isRegisterPage = window.location.pathname
                .toLowerCase()
                .indexOf("summiteventsregister") !== -1;
            var canObserve = "IntersectionObserver" in window;

            document.documentElement.classList.add("fiu-has-apply-bar");

            if (bannerLink && canObserve) {
                new IntersectionObserver(function (entries) {
                    bar.hidden = entries[0].isIntersecting;
                }).observe(bannerLink);
            } else {
                bar.hidden = false;
            }

            if (hero && form && isRegisterPage && !hero.classList.contains("no-display")) {
                register.setAttribute("href", "#" + form.id);
                register.hidden = false;
                // Checks position on scroll, not intersection, so a fast scroll that jumps past the form still counts.
                var hideOnceFormReached = function () {
                    if (form.getBoundingClientRect().top < window.innerHeight) {
                        register.hidden = true;
                        window.removeEventListener("scroll", hideOnceFormReached);
                    }
                };
                window.addEventListener("scroll", hideOnceFormReached, { passive: true });
                hideOnceFormReached();
            }
        });
    </script>
</apex:component>
