      <!-- End Google Tag Manager -->
      <meta charset="utf-8" />
      <meta content="IE=edge" http-equiv="X-UA-Compatible" />
      <meta content="width=device-width, initial-scale=1.0" name="viewport" />
      <title>{!htmlTitle}</title>
      <style>
        #loading .background {
          background-image: url("https://business.fiu.edu/globiz/img/logo.png") !important;
          height: 160px;
        }

        .slds-col img {
          max-width: 99%;
        }

        ul[role=alert] {
          position: relative;
          padding: .75rem 1.25rem !important;
          margin-bottom: 1rem !important;
          border: 1px solid transparent;
          border-top-color: transparent;
          border-right-color: transparent;
          border-bottom-color: transparent;
          border-left-color: transparent;
          border-radius: .25rem;
          color: #721c24;
          background-color: #f8d7da;
          border-color: #f5c6cb;
        }
      </style>
      <script>
        window.dataInfo = [];
        dataInfo.push({
          registerLabel: "{!registerButtonLabel}",
          calendarUrl: "{!calendarUrl}",
          meetUrl: "{!meetUrl}",
          online: "{!onlineEvent}"
        });
      </script>
      <meta content="{!backgroundImageUrl}" property="og:image" />
      <meta content="website" property="og:type" />
      <meta content="{!metaTitle}" property="og:title" />
      <meta content="summary_large_image" name="twitter:card" />
      <link href="https://digicdn.fiu.edu/core/_assets/css/fiu-custom-foundation.css" rel="stylesheet" />
      <link href="https://digicdn.fiu.edu/v2/assets/css/styles.css" rel="stylesheet" />
      <link href="https://digicdn.fiu.edu/core/_assets/css/styles.css?v=1.48.1" rel="stylesheet" />
      <link href="https://digicdn.fiu.edu/fonts/fa/css/all.min.css" rel="stylesheet" />
      <link href="https://digicdn.fiu.edu/fonts/fa/css/v4-shims.min.css" rel="stylesheet" />
      <link href="https://use.typekit.net/erk8tyy.css" rel="stylesheet" />
      <link href="https://digicdn.fiu.edu/fonts/furore.css" rel="stylesheet" />
      <link href="https://core.fiu.edu/_assets/css/brand-2026.css" rel="stylesheet" />
      <link href="{!URLFOR($Resource.sp_open_enrollment, '/css/openEnrollment.css')}" rel="stylesheet" />
      <link href="{!$Resource.FIU_RSVP_Core2026}" rel="stylesheet" />
      <link href="https://digicdn.fiu.edu/core/_assets/favicon/apple-touch-icon.png" rel="apple-touch-icon" sizes="180x180" />
      <link href="https://digicdn.fiu.edu/core/_assets/favicon/favicon-32x32.png" rel="icon" sizes="32x32" type="image/png" />
      <link href="https://digicdn.fiu.edu/core/_assets/favicon/favicon-16x16.png" rel="icon" sizes="16x16" type="image/png" />
      <link href="https://digicdn.fiu.edu/core/_assets/favicon/site.webmanifest" rel="manifest" />
      <link color="#112d54" href="https://digicdn.fiu.edu/core/_assets/favicon/safari-pinned-tab.svg" rel="mask-icon" />
      <meta content="#e8cd7d" name="msapplication-TileColor" />
      <meta content="#ffffff" name="theme-color" />
      <meta content="https://digicdn.fiu.edu/core/_assets/favicon/browserconfig.xml" name="msapplication-config" />
      <!-- <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet"/> -->
      <script src="https://code.jquery.com/jquery-3.6.2.min.js" type="text/javascript"></script>
      <apex:insert name="scriptsHead" />
    </head>
    <body id="rsvpBody" style="min-height: 100vh; display: flex; flex-direction: column;">
      <a class="skip-main-content" href="#main-content">Skip to Main Content</a>
      <apex:includeLightning />
      <div id="compContainer" />
      <!-- Google Tag Manager (noscript) -->
      <noscript>
        <iframe src="https://www.googletagmanager.com/ns.html?id=GTM-PPN6MT" height="0" width="0" style="display: none; visibility: hidden"></iframe>
      </noscript>
      <!-- End Google Tag Manager (noscript) -->
      <main id="main-content" class="slds-scope">
        <div class="fiu-background-blue banner-flex short banner-container energize cyan" id="banner" style="background-position: center center !important; background-image: url({!backgroundImageUrl})">
          <div class="headline-container">
            <div class="row">
              <div class="columns">
                <div class="content-flex">
                  <div class="content">
                    <img alt="FIU Business - Florida International University" class="landing-page-logo" src="{!logoImageUrl}" />
                    <p class="pretitle">{!eventDescription}</p>
                    <h1>{!eventParentDescription}</h1>
                    <p>
                      <a id="registerToday" class="button button--gold" href="#SummitEventsRegister:RsvpTemplate:SummitEventRegisterForm">Register Today!</a>
                    </p>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
        <article aria-hidden="true" aria-label="" id="page-intro">
          <div class="row content-block white no-padding">
            <div class="small-12 columns"></div>
          </div>
        </article>
        <article aria-label="Overview">
          <div id="eventInstanceDescriptionDiv" style="display:none"> {!eventInstanceDescription} </div>
          <div class="slds-grid slds-grid_align-center">
            <div class="slds-col slds-size_1-of-1" id="bodyDiv" style="max-width:1024px;">
              <apex:insert name="body" />
            </div>
          </div>
        </article>
        <article id="article-panel">
          <div id="div-panel">
            <div class="row">
              <div class="small-12 medium-12 columns">
                <c:FIU_ADA_Notice />
              </div>
              <div class="columns small-12 medium-12 text-center">
                <div id="share-with-friends">
                  <!-- AddToAny BEGIN -->
                  <strong class="share-icons-title">Share with friends:</strong>
                  <br />
                  <br />
                  <div class="a2a_kit a2a_kit_size_32 a2a_default_style" style="display: inline-block">
                    <a class="a2a_dd" href="https://www.addtoany.com/share"></a>
                    <a class="a2a_button_facebook"></a>
                    <a class="a2a_button_x"></a>
                    <a class="a2a_button_linkedin"></a>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </article>
      </main>
      <footer style="margin-top: auto;">
        <div class="row footer-flex">
          <div class="columns medium-5">
            <a href="https://business.fiu.edu/" rel="noopener" target="_blank">
              <img alt="FIU Business" class="footer-logo" src="{!logoImageUrl}" width="316" height="82" />
            </a>
            <address> Modesto A. Maidique Campus <br />11200 S.W. 8th Street, MANGO 210 <br />Miami, Florida 33199-0001 <br />305.348.4825 <br />
              <a href="mailto:globiz@fiu.edu">globiz@fiu.edu</a>
            </address>
          </div>
          <div class="columns medium-7 links-and-social">
            <div class="col links">
              <a href="https://titleix.fiu.edu/civil-rights/harassment-and-discrimination/" rel="noopener" target="_blank">Nondiscrimination</a>
              <a href="https://ocr.fiu.edu/title-ix/" rel="noopener" target="_blank">Title IX</a>
              <a href="https://report.fiu.edu/" rel="noopener" target="_blank">Report Discrimination or Harassment</a>
              <a href="https://titleix.fiu.edu/ada-and-accessibility/" rel="noopener" target="_blank">Accessibility</a>
              <a href="https://compliance.fiu.edu/privacy/" rel="noopener" target="_blank">Privacy Policy</a>
            </div>
            <div class="col social">
              <p>
                <strong>Connect with Us!</strong>
              </p>
              <a href="https://www.facebook.com/fiubusiness" rel="noopener" target="_blank">
                <span aria-hidden="true" class="fa-brands fa-facebook"></span>
                <span class="show-for-sr">Facebook</span>
              </a>
              <a href="https://www.linkedin.com/edu/school?id=18094" rel="noopener" target="_blank">
                <span aria-hidden="true" class="fa-brands fa-linkedin"></span>
                <span class="show-for-sr">LinkedIn</span>
              </a>
              <a href="https://www.instagram.com/fiubusiness/" rel="noopener" target="_blank">
                <span aria-hidden="true" class="fa-brands fa-instagram"></span>
                <span class="show-for-sr">Instagram</span>
              </a>
              <a href="https://www.youtube.com/fiubusiness" rel="noopener" target="_blank">
                <span aria-hidden="true" class="fa-brands fa-youtube"></span>
                <span class="show-for-sr">YouTube</span>
              </a>
              <a href="https://twitter.com/fiubusiness" rel="noopener" target="_blank">
                <span aria-hidden="true" class="fa-brands fa-twitter"></span>
                <span class="show-for-sr">X (Twitter)</span>
              </a>
            </div>
          </div>
        </div>
      </footer>
      <script src="{!URLFOR($Resource.summit__SummitEventsAssets, '/js/loading.js')}" type="text/javascript"></script>
      <script src="{!URLFOR($Resource.sp_open_enrollment, '/js/openEnrollment.js')}" type="text/javascript"></script>
      <c:FIU_Floating_Register />
    </body>
    <script src="https://digicdn.fiu.edu/core/_assets/js/core.js?v1.47.0" type="text/javascript"></script>
    <script src="https://business.fiu.edu/_assets/js/info-sessions-listing.js"></script>
    <script src="https://business.fiu.edu/_assets/js/custom.js"></script>
    <script src="https://static.addtoany.com/menu/page.js"></script>
    <script>
      jQuery.noConflict();
      jQuery(document).ready(function($) {
            //Customize Managed Form slightly
            $('form').eq(0).find("div[id^='SummitEventsRegister:FIU_OGI_Template:SummitEventRegisterForm']").eq(1).after(' <br /><br /> <div class="slds-col slds-p-around_x-small slds-size_1-of-1"> <h3 class ="slds-text-heading_medium"> Traveler Information </h3>Please type name as it appears on your passport. This information will be used to book your travel. </div>');
           // $('form').eq(0).find('div').eq(1).after($('form').eq(0).find("div[id^='SummitEventsRegister:FIU_OGI_Template:SummitEventRegisterForm']").eq(1)); 
              $('form').eq(0).find("h3:contains('Additional Information')").eq(0).parent().css('display', 'none'); $('form').eq(0).find("h3:contains('Additional Information')").eq(0).parent().nextAll().addClass('slds-large-size_3-of-6'); $('form').eq(0).find('nav').parent().css('display', 'none'); $('form').eq(0).find("input[id*='mobile']").eq(0).parent('div').parent('div').parent('div').next().find('abbr').remove();
              
                    var persnEmail = $('form').eq(0).find("label:contains('Personal Email')").eq(0).parent('div').parent('div'); $(persnEmail).insertBefore($('form').eq(0).find("div[id*='phoneBlock']").eq(0));
              var pid = $('form').eq(0).find("label:contains('Panther ID')").eq(0).parent('div').parent('div'); 
              $(pid).insertBefore($('form').eq(0).find("div[id*='phoneBlock']").eq(0));

             var dob = $('form').eq(0).find("label:contains('Date of Birth')").eq(0).parent('div').parent('div');
             
              $(dob).insertBefore($('form').eq(0).find("div[id*='phoneBlock']").eq(0));
              var gndr = $('form').eq(0).find("label:contains('Gender')").eq(0).parent('div').parent('div');
           //   var prons = $('form').eq(0).find("label:contains('Pronouns')").eq(0).parent('div').parent('div'); 
           $(gndr).insertBefore($('form').eq(0).find("div[id*='phoneBlock']").eq(0)).addClass('slds-large-size_3-of-6'); 
            //  $(prons).insertBefore($('form').eq(0).find("div[id*='phoneBlock']").eq(0)).addClass('slds-large-size_3-of-6'); $('form').eq(0).find("div[id*='addInfo']").insertBefore($('form').eq(0).find("div[id*='phoneBlock']").eq(0));
              var cobMjr =  $('form').eq(0).find("label:contains('COB Major')").eq(0).parent('div').parent('div'); 
