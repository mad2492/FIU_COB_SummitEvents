              var gpa = $('form').eq(0).find("label:contains('GPA')").eq(0).parent('div').parent('div');
              $(cobMjr).insertBefore($('form').eq(0).find("div[id*='phoneBlock']").eq(0)).addClass('slds-large-size_3-of-6'); 
                $(cobMjr2).insertBefore($('form').eq(0).find("div[id*='phoneBlock']").eq(0)).addClass('slds-large-size_3-of-6'); 
                  $(majorQ).insertBefore($('form').eq(0).find("div[id*='phoneBlock']").eq(0)).addClass('slds-large-size_3-of-6'); 
                    $(gpa).insertBefore($('form').eq(0).find("div[id*='phoneBlock']").eq(0)).addClass('slds-large-size_3-of-6'); 
              
              var hdr = $('form').eq(0).find("h4:contains('Event Details')"); hdr.append($('#eventInstanceDescriptionDiv').text()); $('form').eq(0).find("h4:contains('Event Details')").parent().html(hdr);
            });
            
          var gcId = JSON.parse(localStorage.getItem('gclid')); $Lightning.use("c:facebookRegistrationCompleteApp", function() {
            $Lightning.createComponent("c:facebookRegistrationComplete", {
              registrationId: "{!registrationId}",
              fbc: "{!fbc}",
              fbp: "{!fbp}",
              userAgent: "{!userAgent}",
              clientIpAddress: "{!clientIp}",
              relativePath: "{!relativePath}",
              gclId: gcId?.value
            }, "compContainer", function(cmp) {
              console.log("c:VFPageApp loaded successfully in VF page");
            });
          });
    </script>
  </html>
</apex:page>
