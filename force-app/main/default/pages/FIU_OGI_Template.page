<!--
  @Page Name          : FIU_OGI_Template.page
  @Description        : Office of Global Initiatives (Globiz) template, used for study abroad registrations, most of
                        them paid. Summit's payment page (SP_SummitEventsPayment) renders inside this template, so
                        jQuery stays in <head>, ahead of the payment page's own scripts.
  @Author             : mdennis
  @Group              :
  @Last Modified By   : mdennis
  @Last Modified On   : 11/07/2026
  @Modification Log   :
  ==============================================================================
  Ver         Date                     Author                 Modification
  ==============================================================================
  1.0    8/16/2023, 3:21 PM           mdennis     Initial Version
  2.0    11/7/2026                    mdennis     Register button label from the event, Traveler Information heading
                                                  anchored to First Name (it landed after Student Email on events
                                                  without a deposit), jQuery 3.7.1, notices below the form
-->
<apex:page id="FIU_OGI_Template" lightningStylesheets="true" sidebar="false" showHeader="false" standardStylesheets="false" cache="false" applyHtmlTag="false" controller="SPRsvpTemplateController">
  <apex:slds />
  <html class="no-js" lang="en-US">
    <head>
      <!-- Google Tag Manager -->
      <script>
        (function(w, d, s, l, i) {
          w[l] = w[l] || [];
          // GTM's conversion rules don't check the hostname, so sandbox test registrations must not load it.
          if (d.location.hostname.indexOf(".sandbox.") !== -1) {
            return;
          }
          w[l].push({
            "gtm.start": new Date().getTime(),
            event: "gtm.js"
          });
          var f = d.getElementsByTagName(s)[0],
            j = d.createElement(s),
            dl = l != "dataLayer" ? "&l=" + l : "";
          j.async = true;
          j.src = "https://www.googletagmanager.com/gtm.js?id=" + i + dl;
          f.parentNode.insertBefore(j, f);
        })(window, document, "script", "dataLayer", "GTM-PPN6MT");
      </script>
      <!-- End Google Tag Manager -->
      <meta charset="utf-8" />
      <meta content="IE=edge" http-equiv="X-UA-Compatible" />
      <meta content="width=device-width, initial-scale=1.0" name="viewport" />
      <title>{!htmlTitle}</title>
      <style>
        #loading .background {
          background-image: url("https://business.fiu.edu/globiz/img/logo.png") !important;
          height: 160px;
        }

        .slds-col img {
          max-width: 99%;
        }

        ul[role=alert] {
          position: relative;
          padding: .75rem 1.25rem !important;
          margin-bottom: 1rem !important;
          border: 1px solid transparent;
          border-top-color: transparent;
          border-right-color: transparent;
          border-bottom-color: transparent;
          border-left-color: transparent;
          border-radius: .25rem;
          color: #721c24;
          background-color: #f8d7da;
          border-color: #f5c6cb;
        }
      </style>
      <script>
        window.dataInfo = [];
        dataInfo.push({
          registerLabel: "{!JSENCODE(HTMLENCODE(registerButtonLabel))}",
          calendarUrl: "{!JSENCODE(calendarUrl)}",
          meetUrl: "{!JSENCODE(meetUrl)}",
          online: "{!onlineEvent}"
        });
      </script>
      <meta content="{!backgroundImageUrl}" property="og:image" />
      <meta content="website" property="og:type" />
      <meta content="{!metaTitle}" property="og:title" />
      <meta content="summary_large_image" name="twitter:card" />
      <link href="https://digicdn.fiu.edu/core/_assets/css/fiu-custom-foundation.css" rel="stylesheet" />
      <link href="https://digicdn.fiu.edu/v2/assets/css/styles.css" rel="stylesheet" />
      <link href="https://digicdn.fiu.edu/core/_assets/css/styles.css?v=1.48.1" rel="stylesheet" />
      <link href="https://digicdn.fiu.edu/fonts/fa/css/all.min.css" rel="stylesheet" />
      <link href="https://digicdn.fiu.edu/fonts/fa/css/v4-shims.min.css" rel="stylesheet" />
      <link href="https://use.typekit.net/erk8tyy.css" rel="stylesheet" />
      <link href="https://digicdn.fiu.edu/fonts/furore.css" rel="stylesheet" />
      <link href="https://core.fiu.edu/_assets/css/brand-2026.css" rel="stylesheet" />
      <link href="{!URLFOR($Resource.sp_open_enrollment, '/css/openEnrollment.css')}" rel="stylesheet" />
      <link href="{!$Resource.FIU_RSVP_Core2026}" rel="stylesheet" />
      <link href="https://digicdn.fiu.edu/core/_assets/favicon/apple-touch-icon.png" rel="apple-touch-icon" sizes="180x180" />
      <link href="https://digicdn.fiu.edu/core/_assets/favicon/favicon-32x32.png" rel="icon" sizes="32x32" type="image/png" />
      <link href="https://digicdn.fiu.edu/core/_assets/favicon/favicon-16x16.png" rel="icon" sizes="16x16" type="image/png" />
      <link href="https://digicdn.fiu.edu/core/_assets/favicon/site.webmanifest" rel="manifest" />
      <link color="#112d54" href="https://digicdn.fiu.edu/core/_assets/favicon/safari-pinned-tab.svg" rel="mask-icon" />
      <meta content="#e8cd7d" name="msapplication-TileColor" />
      <meta content="#ffffff" name="theme-color" />
      <meta content="https://digicdn.fiu.edu/core/_assets/favicon/browserconfig.xml" name="msapplication-config" />
      <!-- jQuery loads here, before scriptsHead: Summit's payment page loads its own jQuery and Bootstrap there. -->
      <script
        src="https://code.jquery.com/jquery-3.7.1.min.js"
        integrity="sha256-/JqT3SQfawRcv/BIHPThkBvs0OEvtFFmqPF/lYI/Cxo="
        crossorigin="anonymous"></script>
      <apex:insert name="scriptsHead" />
    </head>
    <body id="rsvpBody" style="min-height: 100vh; display: flex; flex-direction: column;">
      <a class="skip-main-content" href="#main-content">Skip to Main Content</a>
      <apex:includeLightning />
      <div id="compContainer" />
      <!-- Google Tag Manager (noscript) -->
      <noscript>
        <iframe src="https://www.googletagmanager.com/ns.html?id=GTM-PPN6MT" height="0" width="0" style="display: none; visibility: hidden"></iframe>
      </noscript>
      <!-- End Google Tag Manager (noscript) -->
      <main id="main-content" class="slds-scope">
        <div class="fiu-background-blue banner-flex short banner-container energize cyan" id="banner" style="background-position: center center !important; background-image: url({!backgroundImageUrl})">
          <div class="headline-container">
            <div class="row">
              <div class="columns">
                <div class="content-flex">
                  <div class="content">
                    <img alt="FIU Business - Florida International University" class="landing-page-logo" src="{!logoImageUrl}" />
                    <p class="pretitle">{!eventDescription}</p>
                    <h1>{!eventParentDescription}</h1>
                    <p>
                      <!-- The label comes from the event's Register Button Label field (Register_Button_Text__c),
                           falling back to the old wording when it is blank. openEnrollment.js points the link at the
                           form, or hides it when registration is closed. -->
                      <a id="registerToday" class="button button--gold" href="#main-content">{!IF(ISBLANK(registerButtonLabel), 'Register Today!', registerButtonLabel)}</a>
                    </p>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
        <article aria-hidden="true" aria-label="" id="page-intro">
          <div class="row content-block white no-padding">
            <div class="small-12 columns"></div>
          </div>
        </article>
        <article aria-label="Overview">
          <div id="eventInstanceDescriptionDiv" style="display:none"> {!eventInstanceDescription} </div>
          <div class="slds-grid slds-grid_align-center">
            <div class="slds-col slds-size_1-of-1" id="bodyDiv" style="max-width:1024px;">
              <apex:insert name="body" />
            </div>
          </div>
          <div class="slds-grid slds-grid_align-center">
            <div class="slds-col slds-size_1-of-1" style="max-width:1024px;">
              <c:FIU_ADA_Notice />
              <c:FIU_Confirmation_Fallback receipt="{!confirmationReceipt}" />
              <c:FIU_Form_Errors />
            </div>
          </div>
        </article>
        <article id="article-panel">
          <div id="div-panel">
            <div class="row">
              <div class="columns small-12 medium-12 text-center">
                <div id="share-with-friends">
                  <!-- AddToAny BEGIN -->
                  <strong class="share-icons-title">Share with friends:</strong>
                  <br />
                  <br />
                  <div class="a2a_kit a2a_kit_size_32 a2a_default_style" style="display: inline-block">
                    <a class="a2a_dd" href="https://www.addtoany.com/share"></a>
                    <a class="a2a_button_facebook"></a>
                    <a class="a2a_button_x"></a>
                    <a class="a2a_button_linkedin"></a>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </article>
      </main>
      <c:FIU_Footer unit="ogi" logoUrl="{!logoImageUrl}" pushToBottom="true" />
      <script src="{!URLFOR($Resource.summit__SummitEventsAssets, '/js/loading.js')}" type="text/javascript"></script>
      <script src="{!URLFOR($Resource.sp_open_enrollment, '/js/openEnrollment.js')}" type="text/javascript"></script>
      <c:FIU_Floating_Register />
    </body>
    <script src="https://digicdn.fiu.edu/core/_assets/js/core.js?v1.47.0" type="text/javascript"></script>
    <script src="https://business.fiu.edu/_assets/js/info-sessions-listing.js"></script>
    <script src="https://business.fiu.edu/_assets/js/custom.js"></script>
    <script src="https://static.addtoany.com/menu/page.js"></script>
    <script>
      jQuery.noConflict();
      jQuery(document).ready(function($) {
              // Customize Summit's form slightly.
              var form = $('form').eq(0);

              // Traveler Information goes right above First Name. It used to follow the form's second generated
              // element id, which is the deposit block on paid events but Student Email on free ones, and the id
              // also carried this page's name. Anchoring to First Name holds either way; pages without a First
              // Name field (payment, confirmation) are left alone.
              var firstNameBlock = form.find("input[id$=':firstName']").eq(0).parentsUntil(form).last();
              firstNameBlock.before('<div class="slds-col slds-p-around_x-small slds-size_1-of-1"><h3 class="slds-text-heading_medium">Traveler Information</h3>Please type name as it appears on your passport. This information will be used to book your travel.</div>');

              form.find("h3:contains('Additional Information')").eq(0).parent().css('display', 'none'); form.find("h3:contains('Additional Information')").eq(0).parent().nextAll().addClass('slds-large-size_3-of-6'); form.find('nav').parent().css('display', 'none'); form.find("input[id*='mobile']").eq(0).parent('div').parent('div').parent('div').next().find('abbr').remove();

              // Personal details, then the major and GPA questions, move up ahead of the phone fields.
              var phoneBlock = form.find("div[id*='phoneBlock']").eq(0);
              var persnEmail = form.find("label:contains('Personal Email')").eq(0).parent('div').parent('div');
              $(persnEmail).insertBefore(phoneBlock);
              var pid = form.find("label:contains('Panther ID')").eq(0).parent('div').parent('div');
              $(pid).insertBefore(phoneBlock);
              var dob = form.find("label:contains('Date of Birth')").eq(0).parent('div').parent('div');
              $(dob).insertBefore(phoneBlock);
              var gndr = form.find("label:contains('Gender')").eq(0).parent('div').parent('div');
              $(gndr).insertBefore(phoneBlock).addClass('slds-large-size_3-of-6');
              var cobMjr = form.find("label:contains('COB Major')").eq(0).parent('div').parent('div');
              var cobMjr2 = form.find("label:contains('Business Major')").eq(0).parent('div').parent('div');
              var majorQ = form.find("label:contains('your major?')").eq(0).parent('div').parent('div');
              var gpa = form.find("label:contains('GPA')").eq(0).parent('div').parent('div');
              $(cobMjr).insertBefore(phoneBlock).addClass('slds-large-size_3-of-6');
              $(cobMjr2).insertBefore(phoneBlock).addClass('slds-large-size_3-of-6');
              $(majorQ).insertBefore(phoneBlock).addClass('slds-large-size_3-of-6');
              $(gpa).insertBefore(phoneBlock).addClass('slds-large-size_3-of-6');

              var hdr = form.find("h4:contains('Event Details')"); hdr.append($('#eventInstanceDescriptionDiv').text()); form.find("h4:contains('Event Details')").parent().html(hdr);
            });
            
          var gcId = JSON.parse(localStorage.getItem('gclid')); $Lightning.use("c:facebookRegistrationCompleteApp", function() {
            $Lightning.createComponent("c:facebookRegistrationComplete", {
              registrationId: "{!JSENCODE(registrationId)}",
              fbc: "{!JSENCODE(fbc)}",
              fbp: "{!JSENCODE(fbp)}",
              userAgent: "{!JSENCODE(userAgent)}",
              clientIpAddress: "{!JSENCODE(clientIp)}",
              relativePath: "{!JSENCODE(relativePath)}",
              gclId: gcId?.value
            }, "compContainer", function(cmp) {
              console.log("c:VFPageApp loaded successfully in VF page");
            });
          });
    </script>
  </html>
</apex:page>
